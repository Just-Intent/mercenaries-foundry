# The port: a submodule (Just-Intent/Mercenaries-Recompiled, a fork of
# KraftMacAndChee/Mercenaries-Recompiled); anything else under external/ stays out
external/*
!external/Mercenaries-Recompiled

# Game data and anything extracted from it: never commit
*.iso
*.xiso
*.xbe
*.dsk
*.xmv
game_files/
DATAxbox/
extracted/
out/
*.dmp

# Python
__pycache__/
*.pyc
.venv/

# Notes shipped with downloaded images
Vimm's Lair.txt

# Local mod projects (may contain game-derived scripts or assets)
dev-mods/

# Local editor/agent settings
.claude/

# funcmap exports (regenerate any time)
/ghidra_names.json
/mercfoundry_functions.h

# plugin build output
/plugins/out/
/templates.tsv
/objectnames.txt
/dist/
