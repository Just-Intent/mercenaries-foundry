+        "      uint32_t _heap_base = eax;\n"
+        "      recomp_game_heap_check(_heap_base);\n"
+        "      PUSH32(esp, recomp_game_heap_blocks());\n"
+        "      PUSH32(esp, recomp_game_heap_table());\n"
+        "      PUSH32(esp, recomp_game_heap_size());\n"
+        "      eax = _heap_base; }\n"
+        "    PUSH32(esp, eax);"),
