From: Just-Intent <346791974+Just-Intent@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:13:52 -0600
Subject: [PATCH] Plugin overlays

set_overlay lets a plugin show a premultiplied BGRA image over the
game's own frames: the host keeps a copy per plugin (any thread may
replace it) and composites each one at present, after the F9 overlay,
on a 960 x 540 screen. Drawn into the frame, it shows in exclusive
fullscreen without a mode switch.
---
 ports/mercenaries/sdk/mercenaries_plugin.h |  8 ++++++
 ports/mercenaries/src/dev_overlay.c        | 10 ++++++++
 ports/mercenaries/src/plugin_host.cpp      | 30 +++++++++++++++++++++-
 ports/mercenaries/src/plugin_host.h        |  3 +++
 4 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/ports/mercenaries/sdk/mercenaries_plugin.h b/ports/mercenaries/sdk/mercenaries_plugin.h
index dbdbfc2..508f4b6 100644
--- a/ports/mercenaries/sdk/mercenaries_plugin.h
+++ b/ports/mercenaries/sdk/mercenaries_plugin.h
@@ -84,6 +84,14 @@ typedef struct MercPluginHost {
      * exclusive fullscreen (so the window can show) and ignores game input.
      * Call from on_update. */
     int (MERC_PLUGIN_CALL *set_tool_window)(void *, int);
+    /* Show an image over the game's own frames, in fullscreen too: pixels are
+     * premultiplied BGRA (width * height * 4 bytes, rows top to bottom), placed
+     * at x, y on a 960 x 540 screen (scaled to the game's picture). The host
+     * keeps a copy and draws it every frame, after the F9 overlay, until it is
+     * replaced, or hidden with pixels NULL. One image per plugin, at most
+     * 960 x 540. Any thread may call it. Returns 1, or 0 if refused. */
+    int (MERC_PLUGIN_CALL *set_overlay)(void *, const void *pixels, uint32_t width, uint32_t height,
+                                        uint32_t x, uint32_t y);
 } MercPluginHost;
 /* True when the host provides a field (older hosts have a smaller struct). */
 #define MERC_PLUGIN_HOST_HAS(host, field) \
